---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero';
import Services from '../components/sections/Services';
import Grooming from '../components/sections/Grooming';
import Boarding from '../components/sections/Boarding';
import Shop from '../components/sections/Shop';
import Training from '../components/sections/Training';
import Groomers from '../components/sections/Groomers';
import Membership from '../components/sections/Membership';
import PetGallery from '../components/sections/PetGallery';
import Testimonials from '../components/sections/Testimonials';
import FAQ from '../components/sections/FAQ';
import Booking from '../components/sections/Booking';
---

<Layout title="Pawfect Pet Studio | Grooming, Hotel, Sekolah & Toko Anabul">
  <Navbar />
  <main id="main">
    <Hero client:load />
    <Services client:visible />
    <Grooming client:visible />
    <Boarding client:visible />
    <Shop client:visible />
    <Training client:visible />
    <Groomers client:visible />
    <Pricing />
    <Membership client:visible />
    <PetGallery client:visible />
    <Testimonials client:visible />
    <FAQ client:visible />
    <Booking client:idle />
  </main>
  <Footer />
</Layout>

---
const navLinks = [
  { name: 'Services', href: '#services' },
  { name: 'Grooming', href: '#grooming' },
  { name: 'Boarding', href: '#boarding' },
  { name: 'Shop', href: '#shop' },
  { name: 'Training', href: '#training' },
];
---

<header class="sticky top-0 z-50 w-full bg-canvas/90 backdrop-blur-md border-b border-mute/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      {/* Logo */}
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2 group p-2 -ml-2">
          <span class="text-3xl filter grayscale-[20%] group-hover:scale-110 transition-transform duration-300">🐾</span>
          <span class="font-display font-bold text-2xl tracking-tight text-ink">Pawfect<span class="text-primary">.</span></span>
        </a>
      </div>

      {/* Desktop Menu */}
      <nav class="hidden md:flex space-x-8">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-body hover:text-primary font-medium transition-colors duration-200 py-2"
          >
            {link.name}
          </a>
        ))}
      </nav>

      {/* CTA Button */}
      <div class="hidden md:flex items-center">
        <a 
          href="#booking" 
          class="bg-primary text-on-primary px-6 py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors duration-300 flex items-center gap-2 shadow-sm"
        >
          Book Grooming <span>🐾</span>
        </a>
      </div>

      {/* Mobile menu button */}
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-ink hover:text-primary focus:outline-none p-3 -mr-3" aria-label="Toggle menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" id="menu-icon-path" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Menu Panel */}
  <div id="mobile-menu" class="hidden md:hidden bg-canvas border-b border-mute/20 absolute w-full left-0 shadow-lg origin-top transition-all duration-300">
    <div class="px-4 pt-2 pb-6 space-y-2 flex flex-col">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="mobile-nav-link text-ink hover:text-primary font-medium py-3 px-4 rounded-lg hover:bg-canvas-soft transition-colors"
        >
          {link.name}
        </a>
      ))}
      <a 
        href="#booking" 
        class="mobile-nav-link bg-primary text-on-primary px-4 py-4 mt-4 rounded-xl font-bold text-center shadow-sm"
      >
        Book Grooming 🐾
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const path = document.getElementById('menu-icon-path');
  const links = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      menu.classList.remove('hidden');
      // Change icon to X
      path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    } else {
      menu.classList.add('hidden');
      // Change icon to Hamburger
      path.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    }
  }

  btn.addEventListener('click', toggleMenu);

  // Close menu when a link is clicked
  links.forEach(link => {
    link.addEventListener('click', () => {
      if(isMenuOpen) toggleMenu();
    });
  });
</script>

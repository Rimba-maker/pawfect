---
const links = [
  { href: '#services', label: 'Layanan' },
  { href: '#grooming', label: 'Grooming' },
  { href: '#boarding', label: 'Hotel' },
  { href: '#shop', label: 'Toko' },
  { href: '#training', label: 'Sekolah' },
  { href: '#membership', label: 'Club' },
];
---

<header class="sticky top-0 z-50 border-b-[3px] border-ink bg-ink text-marigold">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8" aria-label="Navigasi utama">
    <a href="#top" class="flex items-center gap-2 no-underline" aria-label="Pawfect Pet Studio, ke atas">
      <svg viewBox="0 0 120 110" class="h-9 w-10" aria-hidden="true">
        <path d="M60 36C40 20 20 14 6 18" stroke="#ff5fa2" stroke-width="12" stroke-linecap="round" fill="none"></path>
        <path d="M64 36C84 20 104 14 116 18" stroke="#12b5b0" stroke-width="12" stroke-linecap="round" fill="none"></path>
        <g transform="translate(24 28) scale(.24)">
          <path d="M150 20C70 20 36 88 44 168c8 78 52 142 106 142s98-64 106-142c8-80-26-148-106-148z" fill="#ffb400"></path>
          <path d="M62 52C20 44-6 110 4 196c5 40 40 50 58 14 14-30 22-96 26-142z" fill="#ffb400"></path>
          <path d="M238 52c42-8 68 58 58 144-5 40-40 50-58 14-14-30-22-96-26-142z" fill="#ffb400"></path>
        </g>
      </svg>
      <span class="font-display text-2xl leading-none">Pawfect</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li><a href={l.href} class="rounded-full px-4 py-2 font-bold no-underline transition-colors duration-300 hover:bg-marigold hover:text-ink">{l.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a href="#booking" class="pill !min-h-0 !border-marigold !bg-marigold !px-5 !py-2.5 !text-base !text-ink whitespace-nowrap hover:!bg-pink"><span>Book<span class="hidden sm:inline"> Grooming</span></span></a>
      <details class="relative lg:hidden">
        <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border-[3px] border-marigold [&::-webkit-details-marker]:hidden" aria-label="Buka menu">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        </summary>
        <ul class="absolute right-0 top-14 w-56 rounded-3xl border-[3px] border-marigold bg-ink p-3">
          {links.map((l) => (
            <li><a href={l.href} class="block rounded-full px-4 py-3 text-lg font-bold no-underline hover:bg-marigold hover:text-ink">{l.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu after choosing a link.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

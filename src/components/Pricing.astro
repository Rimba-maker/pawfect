---
import { pricing, pricingOther, sizes } from '../data/content';
---

<section id="pricing" aria-labelledby="pricing-h" class="bg-paper text-ink">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 md:py-28">
    <h2 id="pricing-h" class="t-xl max-w-3xl md:-rotate-1">Daftar harga.</h2>
    <p class="mt-5 max-w-xl text-lg font-medium md:text-xl">Referensi harga per ukuran anabul. Semua angka di sini contoh untuk demo.</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="min-w-0">
        <h3 class="t-md mb-4">Grooming anjing</h3>
        <div class="overflow-x-auto rounded-[1.75rem] border-[3px] border-ink">
          <table class="w-full min-w-[34rem] border-collapse text-left">
            <caption class="sr-only">Harga grooming anjing per ukuran dalam rupiah</caption>
            <thead>
              <tr class="bg-ink text-paper">
                <th scope="col" class="px-5 py-4 font-display text-lg font-normal">Layanan</th>
                {sizes.map((s) => <th scope="col" class="px-5 py-4 text-right font-display text-lg font-normal">{s}</th>)}
              </tr>
            </thead>
            <tbody>
              {pricing.map((r, i) => (
                <tr class={i % 2 ? 'bg-marigold/30' : ''}>
                  <th scope="row" class="px-5 py-4 text-lg font-extrabold">{r.svc}</th>
                  {r.v.map((p) => <td class="px-5 py-4 text-right font-display text-xl [font-variant-numeric:tabular-nums]">{p}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 font-medium">Bulu panjang dengan kusut parah: tambah 20–30%.</p>
      </div>

      <div>
        <h3 class="t-md mb-4">Layanan lain</h3>
        <dl class="divide-y-[3px] divide-dotted divide-ink border-y-[3px] border-ink">
          {pricingOther.map((r) => (
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-bold">{r.svc}</dt>
              <dd class="font-display text-xl [font-variant-numeric:tabular-nums]">{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

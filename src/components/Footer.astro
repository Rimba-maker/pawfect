---
import { branches, IG, WA } from '../data/content';
import { credits } from '../data/images';
---

<footer class="on-ink bg-ink text-paper">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 md:py-24">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <p class="font-display text-[clamp(3rem,10vw,6rem)] leading-[0.9] text-marigold">Pawfect.</p>
        <p class="mt-4 max-w-sm text-xl font-semibold">Furry, fluffy, family. We care.</p>
        <form class="mt-8 flex max-w-sm gap-2" id="news" novalidate>
          <label for="news-email" class="sr-only">Email untuk newsletter</label>
          <input id="news-email" type="email" required placeholder="Email kamu" class="min-w-0 flex-1 rounded-full border-[3px] border-paper bg-transparent px-5 py-3 font-medium placeholder:text-paper/60" />
          <button class="pill !min-h-0 !border-marigold !bg-marigold !px-5 !py-3 !text-base !text-ink hover:!bg-pink">Gabung</button>
        </form>
        <p id="news-msg" class="mt-2 min-h-6 text-sm font-semibold text-marigold" role="status"></p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pink">Cabang contoh</h2>
        <ul class="mt-3 space-y-1 font-medium">
          {branches.map((b) => <li>{b}</li>)}
        </ul>
        <h2 class="mt-8 font-display text-2xl text-pink">Jam buka</h2>
        <p class="mt-3 font-medium">Selasa–Minggu, 09.00–20.00.<br />Senin tutup untuk perawatan studio.</p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pink">Ikuti kami</h2>
        <ul class="mt-3 space-y-1 font-medium">
          <li>Instagram {IG}</li>
          <li>TikTok: cute pets</li>
          <li>YouTube: pet care tips</li>
        </ul>
        <a href={WA} target="_blank" rel="noopener noreferrer" class="pill mt-6 !border-teal !bg-teal !text-ink hover:!bg-paper">Chat WhatsApp</a>
      </div>
    </div>

    <div class="mt-14 border-t-[3px] border-paper/20 pt-8 text-sm font-medium text-paper/80">
      <p>Situs demo Pawfect Pet Studio. Semua nama, angka, harga, cabang, dan ulasan adalah contoh. Foto adalah stok dan tidak menampilkan staf atau pelanggan Pawfect.</p>
      <details class="mt-4">
        <summary class="cursor-pointer font-bold text-marigold">Kredit foto</summary>
        <ul class="mt-3 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
          {credits.map((c) => (
            <li>
              <a class="text-paper" href={c.source === 'Pexels' ? `https://www.pexels.com/photo/${c.id}/` : `https://unsplash.com/photos/${c.id.split('-')[0]}`} target="_blank" rel="noopener noreferrer">{c.alt}</a>
              <span class="opacity-70">, {c.source}{c.author ? `, ${c.author}` : ''}</span>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('news') as HTMLFormElement | null;
  const msg = document.getElementById('news-msg');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (document.getElementById('news-email') as HTMLInputElement).value;
    if (msg) msg.textContent = /.+@.+\..+/.test(email) ? 'Terima kasih! Ini demo, belum ada email tersimpan.' : 'Masukkan alamat email yang valid.';
  });
</script>

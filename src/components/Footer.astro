---
const branches = [
  "Kelapa Gading",
  "Kemang",
  "BSD",
  "Bintaro",
  "Bandung Dago"
];

const socials = [
  { name: "Instagram", handle: "@pawfectpetstudio", href: "#" },
  { name: "TikTok", handle: "@pawfectpetstudio", href: "#" },
  { name: "YouTube", handle: "Pawfect Pet Studio", href: "#" }
];
---

<footer class="bg-ink text-canvas py-16 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      {/* Brand Column */}
      <div class="space-y-6">
        <a href="/" class="flex items-center gap-2 group inline-block py-2">
          <span class="font-display font-bold text-3xl tracking-tight text-canvas">Pawfect<span class="text-primary">.</span></span>
        </a>
        <p class="text-canvas-soft italic font-display text-lg">
          "Furry, fluffy, family — we care."
        </p>
      </div>

      {/* Branches Column */}
      <div>
        <h4 class="font-display font-bold text-lg mb-6 text-primary">Lokasi Cabang</h4>
        <ul class="space-y-2 text-canvas-soft/80 flex flex-col">
          {branches.map(branch => (
            <li>
              <a href="#" class="inline-block py-2 w-full hover:text-canvas transition-colors">{branch}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Hours & Contact */}
      <div>
        <h4 class="font-display font-bold text-lg mb-6 text-primary">Jam Operasional</h4>
        <ul class="space-y-2 text-canvas-soft/80">
          <li class="py-1">Selasa - Minggu</li>
          <li class="py-1 font-semibold text-canvas">09:00 - 20:00</li>
          <li class="text-sm text-mute mt-4 py-1">Senin tutup (maintenance)</li>
        </ul>
        
        <h4 class="font-display font-bold text-lg mt-8 mb-4 text-primary">Sosial Media</h4>
        <ul class="space-y-2 text-canvas-soft/80 flex flex-col">
          {socials.map(social => (
            <li>
              <a href={social.href} class="hover:text-primary transition-colors flex items-center justify-between py-2.5">
                <span>{social.name}</span>
                <span class="text-sm opacity-70">{social.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Newsletter */}
      <div>
        <h4 class="font-display font-bold text-lg mb-6 text-primary">Newsletter</h4>
        <p class="text-canvas-soft/80 mb-4 leading-relaxed">
          Pet care tips & promo eksklusif langsung ke inbox kamu.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault();">
          <input 
            type="email" 
            placeholder="Email kamu" 
            aria-label="Alamat email untuk newsletter"
            class="w-full px-4 py-3.5 rounded-xl bg-canvas/10 border border-canvas/20 text-canvas placeholder:text-canvas/50 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all shadow-sm"
            required
          />
          <button 
            type="submit" 
            class="w-full bg-primary text-on-primary px-4 py-3.5 rounded-xl font-bold hover:bg-primary/90 transition-colors shadow-sm"
          >
            Subscribe 🐾
          </button>
        </form>
      </div>
    </div>
    
    <div class="border-t border-canvas/10 mt-16 pt-8 flex flex-col md:flex-row justify-between items-center text-canvas-soft/60 text-sm gap-4">
      <p class="text-center md:text-left">&copy; {new Date().getFullYear()} Pawfect Pet Studio. All rights reserved.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#" class="py-2 hover:text-canvas transition-colors">Privacy Policy</a>
        <a href="#" class="py-2 hover:text-canvas transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
